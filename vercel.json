{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=120"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/analysis",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=120"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/creation",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=120"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
